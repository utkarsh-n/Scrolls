{
  "//": "OWNER: WP0 — canned GET /api/genealogy for mock mode and contract tests (SPEC §7; Docs/API.md)",
  "method": "GET",
  "path": "/api/genealogy",
  "owner": "WP5",
  "request": null,
  "response": "Genealogy",
  "summary": "Works-as-bars genealogy (samples, interpolates, cover_of, remix_of, version_of): generations, per-decade density, documented edges with locators.",
  "default": "ok",
  "example_request": null,
  "variants": {
    "ok": {
      "status": 200,
      "body": {
        "seed": {
          "doc": 30,
          "title": "Counting Lesson No. 4",
          "maker": "Quellhaven Board of Schools (synthetic)",
          "year": 1952
        },
        "generations": [
          {
            "gen": 1,
            "total": 1,
            "returned": 1,
            "by_decade": { "1990": 1 },
            "rows": [
              {
                "doc": 44,
                "title": "Zero Holds the Place",
                "maker": "MC Ledgerline (synthetic)",
                "date": { "label": "17 May 1994", "precision": "day" },
                "edges": [
                  {
                    "rel_id": 7782,
                    "rel_type": "samples",
                    "evidence_status": "documented",
                    "source_dataset": "demo-records",
                    "locator": "demo-records:liner-notes/zero-holds-the-place"
                  }
                ],
                "synthetic": true
              }
            ]
          }
        ],
        "truncated": { "rows": 0, "cursor": null },
        "note": "Documented links from the synthetic world's records. Absence of a link is not evidence of no sampling.",
        "synthetic": true
      }
    },
    "empty": {
      "when": { "query": { "work": "document:27" } },
      "status": 200,
      "body": {
        "seed": {
          "doc": 27,
          "title": "Field Manual for Wireless Operators",
          "maker": "Harlan Edevane (synthetic)",
          "year": 1936
        },
        "generations": [],
        "truncated": { "rows": 0, "cursor": null },
        "note": "No documented sample, cover, remix or version links. Absence of a link is not evidence of no sampling.",
        "synthetic": true
      }
    },
    "error": {
      "status": 503,
      "body": {
        "error": {
          "code": "QUERY_TIMEOUT",
          "message": "The genealogy query took longer than 5 s and was stopped.",
          "hint": "Narrow the time range or add a filter, then retry.",
          "detail": { "timeout_ms": 5000 }
        }
      }
    }
  }
}
