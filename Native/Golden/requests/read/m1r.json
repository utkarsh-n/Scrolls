{
  "//": "OWNER: N3 — the G3 read plan on m1r (IOS-SPEC §2.2): gen-read.mjs runs it against the reference server and records every request; scrolls-cli diff-read replays the recording. $name refers to the id of an expression tracked by an earlier step.",
  "steps": [
    { "name": "search demo phrase", "search": { "q": "carry the zero", "corpus": "demo" } },
    { "name": "search demo word", "search": { "q": "zero", "corpus": "demo" } },
    { "name": "search demo inflected", "search": { "q": "fluxing", "corpus": "demo" } },
    { "name": "search demo symbol", "search": { "q": "◉", "corpus": "demo" } },
    { "name": "search demo text scope", "search": { "q": "ghost in the margin", "corpus": "demo", "scope": "text" } },
    { "name": "search demo makers", "search": { "q": "Ledgerline", "corpus": "demo", "scope": "makers" } },
    { "name": "search demo titles", "search": { "q": "zero", "corpus": "demo", "scope": "titles" } },
    { "name": "search demo empty result", "search": { "q": "qzxvj", "corpus": "demo" } },
    { "name": "search demo annotations", "search": { "q": "zero", "corpus": "demo", "scope": "annotations" } },
    { "name": "search demo limit", "search": { "q": "the", "corpus": "demo", "limit": 3 } },
    { "name": "search bad limit", "search": { "q": "zero", "corpus": "demo", "limit": 0 } },
    { "name": "search empty query", "search": { "q": "", "corpus": "demo" } },
    { "name": "search cipher zero", "search": { "q": "zero", "corpus": "cipher" } },
    { "name": "search cipher virus", "search": { "q": "virus", "corpus": "cipher" } },
    { "name": "search cipher gene", "search": { "q": "gene", "corpus": "cipher" } },
    { "name": "search cipher bank", "search": { "q": "bank", "corpus": "cipher" } },
    { "name": "search cipher hacker", "search": { "q": "hacker", "corpus": "cipher" } },
    { "name": "search cipher hackers", "search": { "q": "hackers", "corpus": "cipher" } },
    { "name": "search cipher phrase", "search": { "q": "the bank of england", "corpus": "cipher" } },
    { "name": "search cipher hi", "search": { "q": "शून्य", "corpus": "cipher" } },
    { "name": "search cipher gu", "search": { "q": "શૂન્ય", "corpus": "cipher" } },
    { "name": "search cipher shunya", "search": { "q": "shunya", "corpus": "cipher" } },
    { "name": "search cipher sunya", "search": { "q": "sunya", "corpus": "cipher" } },
    { "name": "search cipher algorithm", "search": { "q": "algorithm", "corpus": "cipher" } },
    { "name": "search cipher machine titles", "search": { "q": "machine", "corpus": "cipher", "scope": "titles" } },
    { "name": "search cipher works", "search": { "q": "love", "corpus": "cipher", "scope": "works" } },
    { "name": "search cipher makers", "search": { "q": "Beatles", "corpus": "cipher", "scope": "makers" } },
    { "name": "search cipher themes", "search": { "q": "hip hop", "corpus": "cipher", "scope": "themes" } },
    { "name": "search cipher etymology", "search": { "q": "zero", "corpus": "cipher", "scope": "etymology" } },
    { "name": "search cipher filter lang", "search": { "q": "zero", "corpus": "cipher", "f": "lang:en" } },
    { "name": "search cipher filter coll", "search": { "q": "zero", "corpus": "cipher", "f": "coll:cipher-gutenberg", "limit": 5 } },
    { "name": "search cipher forced lang", "search": { "q": "zero", "corpus": "cipher", "lang": "fr" } },
    { "name": "search cipher name", "search": { "q": "Gene Kelly", "corpus": "cipher" } },
    { "name": "search cipher es", "search": { "q": "cero", "corpus": "cipher" } },
    { "name": "search cipher fr", "search": { "q": "zéro", "corpus": "cipher" } },
    { "name": "search cipher computer", "search": { "q": "computer", "corpus": "cipher" } },
    { "name": "search cipher demo phrase", "search": { "q": "carry the zero", "corpus": "cipher" } },
    { "name": "search real zero", "search": { "q": "zero", "corpus": "real" } },
    { "name": "search cipher very frequent", "search": { "q": "the", "corpus": "cipher", "limit": 5 } },
    { "name": "search cipher hyphen", "search": { "q": "e-mail", "corpus": "cipher" } },

    { "name": "expression 1", "expression": 1 },
    { "name": "expression 2 demo", "expression": 2, "query": { "corpus": "demo" } },
    { "name": "expression 4", "expression": 4 },
    { "name": "expression missing", "expression": 999 },

    { "name": "track zero", "track": { "surface": "zero", "lang": "en", "corpus": "cipher" }, "as": "zero" },
    { "name": "track machine", "track": { "surface": "machine", "lang": "en", "corpus": "cipher" }, "as": "machine" },
    { "name": "track virus", "track": { "surface": "virus", "corpus": "cipher" }, "as": "virus" },
    { "name": "track bank", "track": { "surface": "bank", "lang": "en", "corpus": "cipher" }, "as": "bank" },
    { "name": "track shunya hi", "track": { "surface": "शून्य", "corpus": "cipher" }, "as": "shunya_hi" },
    { "name": "track shunya gu", "track": { "surface": "શૂન્ય", "corpus": "cipher" }, "as": "shunya_gu" },
    { "name": "track hacker", "track": { "surface": "hacker", "lang": "en", "corpus": "cipher" }, "as": "hacker" },
    { "name": "track gene", "track": { "surface": "gene", "lang": "en", "corpus": "cipher" }, "as": "gene" },
    { "name": "track again (idempotent)", "track": { "surface": "Zero", "lang": "en", "corpus": "cipher" }, "as": "zero_again" },
    { "name": "track demo word", "track": { "surface": "ledger", "corpus": "demo" }, "as": "ledger" },
    { "name": "variants off", "variants": { "id": "$machine", "forms": ["machines"], "enabled": false } },

    { "name": "e1 community", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "community" }, "f": "syn:1" },
      "probe": { "kwicSpread": true, "exports": [ { "what": "occurrences", "format": "json" }, { "what": "aggregates", "format": "csv", "tier": "L2" },
        { "what": "passages", "format": "jsonl" } ] } },
    { "name": "e1 language", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "language" } } },
    { "name": "e1 kind total_n", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "kind", "order": "total_n" } } },
    { "name": "e1 cluster", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "cluster" } } },
    { "name": "e1 date_basis estimated off", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "date_basis" },
      "toggles": { "est": 0 } } },
    { "name": "e1 domain alphabetical", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "domain", "order": "alphabetical" } } },
    { "name": "e2 community", "query": { "strands": [{ "type": "expression", "ref": 2 }], "corpus": "demo", "lanes": { "facet": "community" } } },
    { "name": "e3 community max 2", "query": { "strands": [{ "type": "expression", "ref": 3 }], "corpus": "demo", "lanes": { "facet": "community", "max": 2 } } },
    { "name": "e4 symbol", "query": { "strands": [{ "type": "expression", "ref": 4 }], "corpus": "demo", "lanes": { "facet": "community" } } },
    { "name": "e1 e2 together", "query": { "strands": [{ "type": "expression", "ref": 1 }, { "type": "expression", "ref": 2 }], "corpus": "demo",
      "lanes": { "facet": "community" } } },
    { "name": "e1 names counted", "query": { "strands": [{ "type": "expression", "ref": 1 }], "corpus": "demo", "lanes": { "facet": "community" },
      "toggles": { "nm": 1, "dup": 1 } } },
    { "name": "ledger demo", "query": { "strands": [{ "type": "expression", "ref": "$ledger" }], "corpus": "demo", "lanes": { "facet": "community" } } },

    { "name": "zero domain", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "domain" } },
      "probe": { "exports": [ { "what": "occurrences", "format": "csv" }, { "what": "aggregates", "format": "json", "tier": "L3" } ] } },
    { "name": "zero language", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "language" } } },
    { "name": "zero collection", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "collection" } } },
    { "name": "zero modality", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "modality" } } },
    { "name": "zero kind translations", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "kind" },
      "toggles": { "tr": 1 } } },
    { "name": "zero culture", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "culture" } } },
    { "name": "machine domain", "query": { "strands": [{ "type": "expression", "ref": "$machine" }], "corpus": "cipher", "lanes": { "facet": "domain" } } },
    { "name": "virus domain", "query": { "strands": [{ "type": "expression", "ref": "$virus" }], "corpus": "cipher", "lanes": { "facet": "domain" } } },
    { "name": "bank english", "query": { "strands": [{ "type": "expression", "ref": "$bank" }], "corpus": "cipher", "lanes": { "facet": "domain" }, "f": "lang:en" } },
    { "name": "shunya hi language", "query": { "strands": [{ "type": "expression", "ref": "$shunya_hi" }], "corpus": "cipher", "lanes": { "facet": "language" } } },
    { "name": "shunya gu domain", "query": { "strands": [{ "type": "expression", "ref": "$shunya_gu" }], "corpus": "cipher", "lanes": { "facet": "domain" } } },
    { "name": "hacker domain", "query": { "strands": [{ "type": "expression", "ref": "$hacker" }], "corpus": "cipher", "lanes": { "facet": "domain" } } },
    { "name": "gene names counted", "query": { "strands": [{ "type": "expression", "ref": "$gene" }], "corpus": "cipher", "lanes": { "facet": "domain" },
      "toggles": { "nm": 1 } } },
    { "name": "zero and machine", "query": { "strands": [{ "type": "expression", "ref": "$zero" }, { "type": "expression", "ref": "$machine" }],
      "corpus": "cipher", "lanes": { "facet": "language" } } },
    { "name": "zero date_basis", "query": { "strands": [{ "type": "expression", "ref": "$zero" }], "corpus": "cipher", "lanes": { "facet": "date_basis" },
      "f": "coll:cipher-gutenberg" }, "probe": { "minimal": true } },

    { "name": "kwic by expression", "request": { "path": "/api/kwic", "query": { "expr": "$zero", "limit": 20 } } },
    { "name": "kwic by expression lane", "request": { "path": "/api/kwic", "query": { "expr": "$zero", "facet": "language", "lane": "language:en", "from": 1800, "to": 1899, "limit": 20 } } },
    { "name": "kwic no expression", "request": { "path": "/api/kwic", "query": {} } },
    { "name": "passage missing", "request": { "path": "/api/passages/999999999" } },
    { "name": "document missing", "request": { "path": "/api/documents/999999999" } },
    { "name": "document demo 1", "request": { "path": "/api/documents/1" } },
    { "name": "document text slice", "request": { "path": "/api/documents/1/text", "query": { "from": 10, "to": 200 } } },
    { "name": "document text bad range", "request": { "path": "/api/documents/1/text", "query": { "from": 200, "to": 10 } } },
    { "name": "tiles unknown query", "request": { "path": "/api/timeline/tiles", "query": { "q": "0000000000000000", "tier": "L2", "tiles": "29" } } },
    { "name": "tiles bad tier", "request": { "path": "/api/timeline/tiles", "query": { "q": "0000000000000000", "tier": "L9", "tiles": "29" } } },
    { "name": "occurrence missing", "request": { "path": "/api/occurrences/999999999" } }
  ]
}
