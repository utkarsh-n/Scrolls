{
  "//": "OWNER: N0 — the LogicalDump spec (IOS-SPEC §2.3; format in Native/Docs/DIFFERENTIAL.md). Read by Native/Golden/dump.mjs and ScrollsStore/LogicalDump.swift. Every table of schema.sql and device-profile.sql has an entry; ids map to natural keys; masked columns legitimately differ between builds (timestamps, job ids, run code hashes and ICU strings: DV-9, DV-10).",
  "tables": {
    "meta": { "key": ["key"],
      "maskIf": { "column": "key", "in": ["created_at", "icu_version", "data_version", "generation", "generation_built_on", "engine_version", "engine_code_hash", "quality_version"], "mask": ["value"] } },
    "corpus": { "key": ["slug"], "ids": { "id": "self" }, "mask": ["created_at"] },
    "source_adapter": { "key": ["id"], "mask": ["approved_at"], "json": ["config_json"] },
    "collection": { "key": ["slug"], "ids": { "id": "self", "corpus_id": "corpus" }, "mask": ["created_at"], "json": ["caveats_json"] },
    "original_file": { "key": ["sha256"], "mask": ["stored_at"] },
    "import_batch": { "key": ["collection.slug", "adapter_id", "file_sha256", "file_name", "format", "status"],
      "ids": { "id": "self", "collection_id": "collection" }, "mask": ["created_at", "committed_at", "job_id"],
      "json": ["mapping_json", "options_json", "summary_json"] },
    "import_issue": { "key": ["batch_id", "severity", "code", "line", "col", "field", "message"],
      "ids": { "id": "self", "batch_id": "import_batch" } },

    "document": { "key": ["collection.slug", "ext_id"],
      "ids": { "id": "self", "collection_id": "collection", "import_batch_id": "import_batch", "dup_of": "document" },
      "mask": ["created_at", "deleted_at"], "json": ["original_meta_json"] },
    "document_text": { "key": ["document"], "ids": { "document_id": "document" },
      "virtual": { "original": "TextStore.fullText → sha256" } },
    "document_field": { "key": ["document", "field"], "ids": { "document_id": "document" } },
    "document_alias": { "key": ["document", "ext_id"], "ids": { "document_id": "document" } },
    "doc_tag": { "key": ["document", "scheme", "value", "provenance"], "ids": { "document_id": "document", "run_id": "analysis_run" } },
    "doc_minhash": { "key": ["document"], "ids": { "document_id": "document" } },

    "date_assertion": { "key": ["subject_type", "subject_id", "role", "is_chronology", "raw", "rule", "lo_day", "hi_day", "asserted_by"],
      "ids": { "id": "self", "subject_id": { "by": "subject_type" } } },
    "date_rtree": { "key": ["id"], "ids": { "id": "date_assertion" } },
    "language_period": { "key": ["lang"] },
    "doc_bin": { "key": ["level", "bin", "document"], "ids": { "document_id": "document" } },
    "doc_tokens": { "key": ["document", "plang", "field_class"], "ids": { "document_id": "document" } },

    "passage": { "key": ["document", "field", "ord"], "ids": { "id": "self", "document_id": "document" } },
    "passage_fts": { "virtual": { "rows": "rowid → passage key; fts5vocab instance (term, doc key, offset) → sha256" } },
    "passage_vocab_row": { "skip": "fts5vocab view of passage_fts; passage_fts is dumped through passage_vocab_inst" },
    "passage_vocab_inst": { "skip": "fts5vocab view of passage_fts; passage_fts is dumped through it" },
    "label_tri": { "key": ["kind", "ref", "label"] },

    "expression": { "key": ["kind", "lang", "norm", "corpus"], "ids": { "id": "self", "corpus_id": "corpus" },
      "mask": ["created_at"], "json": ["meta_json"] },
    "expression_variant": { "key": ["expression", "lang", "norm"], "ids": { "id": "self", "expression_id": "expression" } },
    "expression_state": { "key": ["expression"], "ids": { "expression_id": "expression", "run_id": "analysis_run" }, "mask": ["updated_at"] },
    "occurrence": { "key": ["run_id", "passage_id", "start_off", "expression_id"],
      "ids": { "id": "self", "expression_id": "expression", "variant_id": "expression_variant", "passage_id": "passage",
               "document_id": "document", "run_id": "analysis_run" } },
    "expr_doc": { "key": ["expression_id", "run_id", "document_id", "plang", "field_class"],
      "ids": { "expression_id": "expression", "document_id": "document", "run_id": "analysis_run" } },

    "etymon": { "key": ["key"], "ids": { "key": "self" } },
    "etymon_parent": { "key": ["key", "parent_key"] },
    "etymon_member": { "key": ["key", "lang", "word"] },

    "analysis_run": { "key": ["stage", "pipeline_version", "params_hash", "input_fingerprint"], "ids": { "id": "self" },
      "mask": ["code_hash", "icu_version", "data_version", "job_id", "started_at", "finished_at"],
      "json": ["params_json", "scope_json", "upstream_run_ids", "gate_json", "metrics_json"] },
    "time_window": { "key": ["run_id", "scheme", "lo_year", "hi_year", "label"], "ids": { "id": "self", "run_id": "analysis_run" } },
    "collocation": { "key": ["run_id", "expression_id", "slice_key", "collocate"],
      "ids": { "run_id": "analysis_run", "expression_id": "expression" } },
    "vector_space": { "key": ["run_id", "lang", "lo_year", "hi_year", "pooled"], "ids": { "id": "self", "run_id": "analysis_run" },
      "mask": ["rel_path"], "json": ["collections_json"] },
    "space_alignment": { "key": ["run_id", "from_space", "to_space"],
      "ids": { "id": "self", "run_id": "analysis_run", "from_space": "vector_space", "to_space": "vector_space" }, "mask": ["rel_path"] },
    "sense_cluster": { "key": ["run_id", "expression_id", "ord"],
      "ids": { "id": "self", "run_id": "analysis_run", "expression_id": "expression" }, "json": ["distinctive_json"] },
    "cluster_member": { "key": ["cluster_id", "occurrence_id"], "ids": { "cluster_id": "sense_cluster", "occurrence_id": "occurrence" } },
    "cluster_share": { "key": ["cluster_id", "window_id"], "ids": { "cluster_id": "sense_cluster", "window_id": "time_window" } },
    "cluster_transition": { "key": ["run_id", "kind", "window_id", "from_cluster", "to_cluster"],
      "ids": { "id": "self", "run_id": "analysis_run", "from_cluster": "sense_cluster", "to_cluster": "sense_cluster", "window_id": "time_window" } },
    "drift_result": { "key": ["run_id", "expression_id", "metric", "slice_a_json", "slice_b_json"],
      "ids": { "id": "self", "run_id": "analysis_run", "expression_id": "expression" },
      "json": ["slice_a_json", "slice_b_json", "gate_detail_json", "caveats_json"] },
    "compare_log": { "key": ["expression_key", "request_hash", "notable_count"], "ids": { "id": "self" },
      "mask": ["session_id", "at"], "json": ["measures_json"] },

    "rel_type": { "key": ["code"] },
    "hypothesis_group": { "key": ["target_type", "target_ref", "question", "created_by"],
      "ids": { "id": "self", "target_ref": { "by": "target_type", "map": { "cluster": "sense_cluster" } } }, "mask": ["created_at"] },
    "relationship": { "key": ["rel_type", "src_type", "src_ref", "dst_type", "dst_ref", "source_dataset", "source_locator", "method", "run_id"],
      "ids": { "id": "self", "src_ref": { "by": "src_type", "map": { "cluster": "sense_cluster" } },
               "dst_ref": { "by": "dst_type", "map": { "cluster": "sense_cluster" } },
               "run_id": "analysis_run", "hypothesis_group_id": "hypothesis_group" },
      "mask": ["created_at"] },
    "relationship_evidence": { "key": ["relationship_id", "role", "passage_id", "start_off", "end_off", "detail_json"],
      "ids": { "id": "self", "relationship_id": "relationship", "passage_id": "passage" },
      "mask": ["added_at"], "json": ["anchor_json", "detail_json"] },
    "relationship_revision": { "key": ["relationship_id", "rev"],
      "ids": { "id": "self", "relationship_id": "relationship", "annotation_id": "annotation" },
      "mask": ["at"], "json": ["before_json"], "virtual": { "after_json": "Revisions.expanded" } },

    "dimension_def": { "key": ["key"], "json": ["options_json"] },
    "annotation": { "key": ["target_type", "target_ref", "kind", "author", "layer", "method", "run_id", "supersedes", "anchor_json"],
      "ids": { "id": "self", "target_ref": { "by": "target_type", "map": { "cluster": "sense_cluster" } },
               "run_id": "analysis_run", "supersedes": "annotation" },
      "mask": ["created_at"], "json": ["anchor_json"] },
    "annotation_revision": { "key": ["annotation_id", "rev"], "ids": { "id": "self", "annotation_id": "annotation" },
      "mask": ["at"], "json": ["dimensions_json", "tags_json", "evidence_refs_json"] },
    "annotation_fts": { "skip": "contentless FTS5 with no fts5vocab table in schema.sql; its rows are annotation_revision bodies (dumped there)" },

    "saved_view": { "key": ["slug"], "ids": { "id": "self" }, "mask": ["created_at", "deleted_at", "data_version"],
      "json": ["state_json", "run_ids_json"], "text": ["snapshot_svg"] },
    "job": { "skip": "operational queue state (differs per run); not evidence" },
    "job_event": { "skip": "operational queue state (differs per run); not evidence" },
    "query_def": { "skip": "cache (IOS-SPEC §3.3: not used on the phone)" },
    "tile_cache": { "skip": "cache (IOS-SPEC §3.3: not used on the phone)" },
    "layout_cache": { "skip": "cache (IOS-SPEC §3.3: rebuilt)" },
    "theme_assoc": { "key": ["theme", "other"] },

    "text_storage": { "key": ["document"], "ids": { "document_id": "document" } },
    "text_chunk": { "skip": "device profile; covered by document_text.original" },
    "id_counter": { "key": ["tbl", "slot"] },
    "pack_install": { "key": ["pack_sha256"], "mask": ["installed_at"] },
    "journal_applied": { "key": ["seq"], "mask": ["applied_at"], "json": ["max_ids_json"] },
    "saved_view_portable": { "key": ["view_id"], "ids": { "view_id": "saved_view" }, "mask": ["created_at"], "json": ["portable_json"] }
  }
}
