{
  "//": "OWNER: WP0 — canned GET /api/collocations for mock mode and contract tests (SPEC §7; Docs/API.md)",
  "method": "GET",
  "path": "/api/collocations",
  "owner": "WP4",
  "request": null,
  "response": "Collocations",
  "summary": "Collocates of an expression in a slice (logDice; G² ≥ 10.83, f ≥ 5, q < .05) or a gate with a widening suggestion.",
  "default": "ok",
  "example_request": null,
  "variants": {
    "ok": {
      "status": 200,
      "body": {
        "gate": "ok",
        "expr": 12,
        "slice": "1994-2026",
        "window": "±5 tokens",
        "measure": "logDice",
        "thresholds": { "g2": 10.83, "f": 5, "q": 0.05 },
        "collocates": [
          { "term": "counted", "f_xy": 31, "logDice": 12.1, "g2": 88.4, "q": 0.0001 },
          { "term": "hold", "f_xy": 24, "logDice": 11.7, "g2": 61.2, "q": 0.0003 },
          { "term": "uncredited", "f_xy": 12, "logDice": 10.9, "g2": 35.5, "q": 0.002 }
        ],
        "label": "context words, not meanings",
        "provenance": {
          "data_version": 47,
          "run_ids": { "materialize": { "12": 31 } },
          "tokenizer": "u61m-1",
          "segmenter": "seg-1",
          "synthetic": true,
          "collections": ["demo-world"],
          "licenses": ["CC0 (synthetic)"]
        }
      }
    },
    "gated": {
      "when": { "query": { "expr": "13" } },
      "status": 200,
      "body": {
        "gate": "insufficient_occurrences",
        "expr": 13,
        "slice": "1965-1975",
        "needed": { "occurrences": 20 },
        "have": { "occurrences": 12 },
        "suggestion": {
          "label": "Widen to 1965–1999 (35 occurrences)",
          "slice": "1965-1999",
          "would_have": { "occurrences": 35 }
        },
        "note": "Too few occurrences (12; needs 20). Showing KWIC.",
        "kwic": [
          {
            "passage": 1702,
            "doc": 38,
            "start": 53,
            "end": 72,
            "left": "Bit 7 flips on the third pass — as Wrexley put it, a ",
            "match": "ghost in the margin",
            "right": ".",
            "title": "Lab notebook",
            "date": { "label": "2 Aug 1971", "precision": "day" },
            "lane": "community:office-lab",
            "synthetic": true
          }
        ]
      }
    },
    "error": {
      "status": 503,
      "body": {
        "error": {
          "code": "QUERY_TIMEOUT",
          "message": "The collocation query took longer than 5 s and was stopped.",
          "hint": "Narrow the time range or add a filter, then retry.",
          "detail": { "timeout_ms": 5000 }
        }
      }
    }
  }
}
