            "progress": 0.41
          },
          "shape": "AdapterEvent"
        }
      ]
    },
    "error": {
      "status": 403,
      "body": {
        "error": {
          "code": "E_FORBIDDEN_ORIGIN",
          "message": "This request did not come from the Scrolls page on this computer.",
          "hint": "Open Scrolls at http://127.0.0.1:3460/ and retry from there.",
          "detail": null
        }
      }
    }
  }
}
